# CV Copilot — environment template. Copy to .env and fill in.
# .env is gitignored; never commit real secrets.

# Anthropic API key for AI extract / polish / tailoring / cover letters plus
# the managed-credit operator subsidy. Optional locally; deterministic parsing,
# deterministic ATS scoring, editing, preview, and PDF build still work without
# it. This is the ONLY operator-funded provider.
ANTHROPIC_API_KEY=

# ── Provider registry ───────────────────────────────────────────────────────
# User-provider keys are stored encrypted in the per-user vault. Do not place
# tenant-provider secrets in the server env. Gemini, OpenRouter, DeepSeek, Groq,
# Mistral, and custom OpenAI-compatible providers are BYO-key/provider-config
# paths, not managed-credit providers.
#
# SECURITY — DO NOT SET ambient provider SDK keys on the server. Several SDKs
# auto-read these names and could silently override a user's vault key.
#   GOOGLE_API_KEY=     # NEVER set on the server
#   GEMINI_API_KEY=     # NEVER set on the server
#   OPENAI_API_KEY=     # NEVER set on the server
#   OPENROUTER_API_KEY= # NEVER set on the server
#   DEEPSEEK_API_KEY=   # NEVER set on the server
#   GROQ_API_KEY=       # NEVER set on the server
#   MISTRAL_API_KEY=    # NEVER set on the server

# Ollama is local-only and stores no secret.
ONEPAGER_OLLAMA_BASE_URL=http://127.0.0.1:11434
ONEPAGER_OLLAMA_MODEL=llama3.1

# Hosted OpenAI-compatible vendors use fixed base URLs in the registry. Set only
# default model/allowlist knobs here; users still bring their own keys.
ONEPAGER_OPENROUTER_MODEL=
ONEPAGER_DEEPSEEK_MODEL=
ONEPAGER_GROQ_MODEL=
ONEPAGER_MISTRAL_MODEL=

# Custom OpenAI-compatible endpoint. Must be public HTTPS; private/internal
# addresses are rejected to avoid SSRF.
ONEPAGER_OPENAI_COMPATIBLE_BASE_URL=
ONEPAGER_OPENAI_COMPATIBLE_MODEL=

# Optional comma-separated allowlist overrides, e.g.
# ONEPAGER_OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,google/gemini-flash-1.5

# Supabase / auth / vault.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
ONEPAGER_KEK=
ONEPAGER_REVIEW_TOKEN_SECRET=
FLASK_SECRET_KEY=

# Optional ATS rubric kill-switch. Unset/truthy enables rubric where a provider
# key resolves; falsey values force deterministic ATS scoring for every request.
ONEPAGER_ATS_RUBRIC=

# Cloudflare R2 — PDF storage + delivery (Stage 8). OPTIONAL: the operator
# creates an EU R2 bucket + an S3 API token for live PDF delivery (signed
# URLs). Leave all four UNSET for the direct-stream fallback (the editor renders
# and streams PDFs in-process — fully functional with no R2). All four must be
# set together to enable the R2 cache/delivery path.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Required only when all R2 settings are intentionally absent. This is a
# durable operator assertion that this deployment has never stored PDFs in R2.
# Do not set it after R2 has ever been enabled; retain working bucket
# credentials instead so erasure can delete historical/orphaned objects.
ONEPAGER_R2_NEVER_USED=

# Public base URL of the deployment (Stage 9). Used for the landing page's SEO
# canonical/og:url, robots.txt, and sitemap.xml. Defaults to
# http://localhost:8000 for local dev; set it to your real https origin in
# production (e.g. https://onepager.example.com).
ONEPAGER_DOMAIN=
ACME_EMAIL=
PUBLIC_BASE_URL=

# Contact address published on /privacy for GDPR requests (access, export,
# erasure). REQUIRED when PUBLIC_BASE_URL is non-loopback; hosted startup fails
# closed without it. Loopback development uses privacy@localhost.invalid.
# Set this to an address monitored by the actual deployment operator.
ONEPAGER_PRIVACY_CONTACT=

# Production account-erasure worker. The defaults claim at most 20 D+30
# accounts per cycle for 30 minutes and poll every 5 minutes. Keep the lease
# longer than the worst-case R2/photo/Auth cleanup time.
ONEPAGER_ACCOUNT_PURGE_BATCH_SIZE=20
ONEPAGER_ACCOUNT_PURGE_LEASE_MINUTES=30
ONEPAGER_ACCOUNT_PURGE_POLL_SECONDS=300

# Seed/reference CV the editor loads. Unset, the server prefers content/cv.yaml
# when it exists and otherwise falls back to content/cv.example.yaml — and
# cv.yaml is typically the operator's real CV (real name, email, phone). Set
# this to cv.example.yaml to pin screenshot capture and demo runs to the
# fixture so no personal data is rendered. Accepts a filename under content/ or
# an absolute path.
ONEPAGER_CV_FILE=

# Job ingestion guardrails. URL-only imports are disabled unless the source
# host is explicitly allowlisted; pasted/manual import works without these.
ONEPAGER_JOB_URL_ALLOWLIST=
ONEPAGER_JOB_URL_RATE_LIMIT_PER_MINUTE=20

# LinkedIn adapter slot. Default-disabled. Enable only with documented
# official/partner permission; this build still rejects blind scraping and does
# not store LinkedIn cookies or sessions.
LINKEDIN_APPROVED_ADAPTER_ENABLED=
LINKEDIN_PARTNER_CONFIG_ID=
ONEPAGER_LOCAL_JOBS_DB=
ONEPAGER_LOCAL_JOBS_FRESH_DAYS=7

# External apply architecture. Backend-only and default-disabled. Actions run
# only when ENABLED=1 and KILL_SWITCH=0; unset/blank kill switch values fail
# closed. Dry-run is limited to comma-separated fixture hosts listed here and
# never fetches live pages.
ONEPAGER_EXTERNAL_APPLY_ENABLED=
ONEPAGER_EXTERNAL_APPLY_KILL_SWITCH=1
ONEPAGER_EXTERNAL_APPLY_SAFE_FIXTURE_HOSTS=

# Product analytics (Stage 9). OPTIONAL and NO-OP by default: leave POSTHOG_KEY
# UNSET and analytics does nothing (no network calls, no overhead). Set it to a
# PostHog project API key to record the two activation events (signup,
# first_export). POSTHOG_HOST defaults to the EU cloud.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.posthog.com

# ── DEV / LOOPBACK ONLY — REFUSED ON PUBLIC ORIGINS ──────────────────────────
# Demo mode adds a one-click "Demo login" button and swaps the LLM for a
# deterministic OFFLINE stub (no API key, no managed credits consumed). It is a
# convenience for loopback testing only. The server refuses demo mode when
# PUBLIC_BASE_URL names a non-loopback origin and rejects demo requests whose
# Host or peer address is non-loopback. Leave it unset in every deployment.
#   Truthy = 1 | true | yes (case-insensitive). Default OFF.
ONEPAGER_DEMO_MODE=
# Optional remote Supabase demo grant. Both values must be set explicitly or
# the loopback demo remains entirely local. Never use production credentials.
# Read server-side only; never sent to the browser or logged.
DEMO_EMAIL=
DEMO_PASSWORD=
